{% macro input(id, label, type="text", value="", required=true, classes="", spanMessage="") %}
    <label for="{{ id }}">{{ label }}</label>
        <div class="inputField">
            <input id="{{ id }}" name="{{ id }}" type="{{ type }}" value="{{ value }}" {% if classes != "" %} class="{{ classes }}{% if error %} invalid {% endif %}" {% endif %} {% if required %} required {% endif %}>
            <span></span>
        </div>
    {% endmacro %}